# ==========================================
# Fire and Smoke Security System Configuration
# ==========================================

# Server settings
PORT=5000
DEBUG=False
SECRET_KEY=change-this-in-production-random-secret-key

# Camera source: 0 for default webcam, or RTSP/HTTP URL for IP/CCTV camera
# Example RTSP: rtsp://user:pass@192.168.1.100:554/stream1
CAMERA_SOURCE=0
CAMERA_ID=CAM-BUILDING-01
CAMERA_LOCATION=Main Foyer - North Corridor
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720
CAMERA_FPS_TARGET=30

# Detection Models
FIRE_SMOKE_MODEL_PATH=models/fire_smoke_yolov8n.pt
SCREEN_DETECTOR_MODEL_PATH=models/yolov8n.pt

# Confidence and NMS thresholds
FIRE_CONFIDENCE_THRESHOLD=0.45
SMOKE_CONFIDENCE_THRESHOLD=0.40
DETECTION_IOU_THRESHOLD=0.45

# Mobile Phone & Screen False-Positive Prevention
ENABLE_SCREEN_REJECTION=True
SCREEN_DETECTION_CONFIDENCE=0.35
SCREEN_OVERLAP_REJECT_THRESHOLD=0.65
SCREEN_OVERLAP_UNCERTAIN_THRESHOLD=0.25

# Temporal Filtering & Confirmation Logic
TEMPORAL_WINDOW_SIZE=8
TEMPORAL_CONFIRM_COUNT=5
ALERT_COOLDOWN_SECONDS=30
CLEAR_CONSECUTIVE_FRAMES=15

# Security Notification Settings (Optional)
# If unconfigured or delivery fails, incidents still display on local dashboard
ENABLE_NOTIFICATIONS=False
NOTIFICATION_TYPE=smtp
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Webhook Alternative (e.g. Slack/Teams/custom security webhook)
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=2

# Audio Alert Settings
ENABLE_AUDIO_ALARM=True
